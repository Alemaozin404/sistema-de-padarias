# Copie para .env.local e preencha. Nenhum valor real deve ser commitado.

# Banco de dados (PostgreSQL / Neon)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@host/db?sslmode=require"

# Autenticação (Better Auth)
BETTER_AUTH_SECRET="gere com: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Gateway de pagamento (Asaas)
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_KEY=""
# Mínimo de 32 caracteres; configure o mesmo valor no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"

# E-mail transacional (Resend)
RESEND_API_KEY=""
EMAIL_FROM="nao-responda@seudominio.com.br"

# Imagens (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Jobs (header Authorization: Bearer $CRON_SECRET)
CRON_SECRET=""

# Monitoramento
SENTRY_DSN=""

# Públicas
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_SUPPORT=""
